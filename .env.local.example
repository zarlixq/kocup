NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=

# Production'da gerçek domain ile değiştirilmeli (örn: https://kocup.com)
NEXT_PUBLIC_SITE_URL=https://www.kocupakedemi.com

# Google Search Console verification (opsiyonel, boşsa meta tag render edilmez)
GOOGLE_SITE_VERIFICATION=

# Google Ads conversion etiketi — /basvuru başarılı olunca ateşlenen conversion event'i.
# Format: AW-XXXXXXXXXX/YYYYYYYYYYYYYYYYYY  (Google Ads > Conversions > Tag setup)
# Boşsa koddaki mevcut fallback değer kullanılır.
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=

# E-posta (Resend) — doğrulama, şifre sıfırlama ve davet e-postaları.
# Boşsa: doğrulama/şifre sıfırlama Supabase'in kendi (saatlik limitli) e-postasıyla gider,
# davet bağlantıları müdür panelinde "kopyala" olarak gösterilir.
RESEND_API_KEY=
# Resend'de doğrulanmış alan adından gönderici, örn: KoçUp <bildirim@kocupakademi.com>
EMAIL_FROM=

# Cloudflare Turnstile — kayıt/giriş/davet kabulü bot koruması. İkisi de boşsa koruma kapalı.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
